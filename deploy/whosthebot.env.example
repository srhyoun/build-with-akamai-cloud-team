# Copy to /etc/whosthebot.env on the Linode (docs/DEPLOY.md step 6), fill in, chmod 600. Never commit the filled-in copy.
# Same names as the workshop's .env. No quotes, no comments after a value.

# Node listens here; Caddy forwards https://<host> to it. Keep 8080 (the firewall blocks it from outside).
PORT=8080
# Used in the QR / share links. https://<ip-with-dashes>.sslip.io, or your domain.
PUBLIC_APP_URL=

# Akamai Cloud Inference. Team key from event staff, starts with sk_aka_.
AKAMAI_BASE_URL=https://api.akamai-inference.com/v1
AKAMAI_API_KEY=
CHAT_MODEL=qwen3-8-27b

# Managed PostgreSQL, from the database's connection details.
PGHOST=
PGPORT=
PGUSER=akmadmin
PGPASSWORD=
PGDATABASE=defaultdb

# Object Storage, bucket in Chicago (E3 endpoint).
OBJ_ENDPOINT=https://us-ord-10.linodeobjects.com
OBJ_BUCKET=
OBJ_ACCESS_KEY=
OBJ_SECRET_KEY=
